  <text xml:lang="it">

    <body>

      <div type="poem" xml:id="silene-conica">

        <head>Silene conica</head>

        <head type="sub">I Campaneddhgi</head>

        <!-- FOGLIO 1 -->

        <div type="page" n="1">

          <head>Foglio 1 di 1</head>

          <dateline>31 Marzo</dateline>

          <note type="material">
            Componimento poetico manoscritto.
            Il foglio reca la firma di Dagmar Davidson Calabrese.
          </note>

          <lg type="stanza">

            <l>Una vecchia strada</l>
            <l>malconcia</l>
            <l>serpeggia</l>
            <l>su per la collina.</l>
            <l>I prati intorno</l>
            <l>sono ancora vestiti</l>
            <l>nel tenero verde</l>
            <l>della primavera.</l>

          </lg>

          <lg type="stanza">

            <l>Qui nella sabbia</l>
            <l>fioriscono</l>
            <l>i <name type="vernacular">campaneddhgi rossi</name></l>
            <l>una fioritura</l>
            <l>breve ed intensa,</l>
            <l>prima che la natura</l>
            <l>si bruci</l>
            <l>ed ingiallisca.</l>

          </lg>

          <signed>
            Firma:
            <persName>Dagmar Davidson Calabrese</persName>
          </signed>

        </div>

      </div>

    </body>

  </text>

