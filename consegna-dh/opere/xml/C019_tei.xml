    <text xml:lang="sv">

        <body>

            <div type="poem">

                <head>Julmeditation</head>

                <lg type="stanza">

                    <l>I den tiden det leder sig <unclear>[?]</unclear>,</l>
                    <l>att granarna skola klädas,</l>
                    <l>att alla människor skola glädjas</l>
                    <l>att alla barn skola få gåvor.</l>

                </lg>

                <lg type="stanza">

                    <l>I den tiden</l>
                    <l>ruvar vintern som mörkast,</l>
                    <l>är människosinnet som dystrast,</l>
                    <l>känns arbetsbördan som tyngst.</l>

                </lg>

                <lg type="stanza">

                    <l>I den tiden</l>
                    <l>lyser neonljusen som grällast,</l>
                    <l>stå lövträden som naknast,</l>
                    <l>är tystnaden i de stora skogarna som störst.</l>

                </lg>

                <lg type="stanza">

                    <l>Då predikas glädjen och friden</l>
                    <l>bland människorna, mitt i allt jäktet.</l>
                    <l>Låtom oss stanna och besinna.</l>
                    <l>Dröja i stillhet och eftertanke.</l>

                </lg>

                <lg type="stanza">

                    <l>För att, när året lider mot sitt slut</l>
                    <l>med mod och tillförsikt</l>
                    <l>kunna se fram</l>
                    <l>emot allt det okända,</l>
                    <l>som ett kommande år bär i sitt sköte.</l>

                </lg>

            </div>

