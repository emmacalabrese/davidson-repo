      <div type="poem">

        <head>Anemoli</head>

          <!-- FOGLIO 1 -->

                <div type="page" n="1">

                    <head>Foglio 1 di 1</head>

                    <dateline>
                        28 Febbraio
                        <note type="margin">
                            A margine: 3
                        </note>
                    </dateline>

                    <lg type="stanza">

                        <l>Anemoli,</l>
                        <l>i principali siete,</l>
                        <l>dei fiori della primavera.</l>
                        <l>Come astri viola</l>
                        <l>luccicati</l>
                        <l>tra scuri pezzi di terra</l>
                        <l>sotto un tepido sole</l>
                        <l>di febbraio,</l>
                        <l>mentre le viti dei campi,</l>
                        <l>nude e nodose,</l>
                        <l>si contorcano,</l>
                        <l>quasi portasssero</l>
                        <l>sulle loro spalle</l>
                        <l>tutte le fatiche</l>
                        <l>di questo mondo.</l>

                    </lg>

                    <closer>
                        <signed>Dagmar Davidson Calabrese</signed>
                        <note type="signature">Sigla: DC</note>
                    </closer>

                </div>

            </div>

        </body>

    </text>

