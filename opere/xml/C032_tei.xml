    <text xml:lang="it">

        <body>

            <div type="poem">

                <head>Bellis</head>

          <!-- FOGLIO 1 -->

                <div type="page" n="1">

                    <head>Foglio 1 di 3 – Bozza</head>

                    <dateline>20 Febbraio</dateline>

                    <head>Margheritine</head>

                    <note type="material">
                        Bozza manoscritta con cancellature
                        e aggiunte.
                        In alto a sinistra è presente
                        una macchia di colore.
                    </note>

                    <lg>

                        <l>Siamo in febbraio</l>
                        <l>e la lunga primavera</l>
                        <l>del Salento</l>
                        <l>sta cominciando.</l>
                        <l>Tra ruderi caduti</l>
                        <l>e terreni abbandonati</l>
                        <l>un sentiero si aggira,</l>
                        <l>serpeggia,</l>
                        <l>come un bianco ruscello,</l>
                        <l>coperto</l>
                        <l>da mille e mille</l>
                        <l>piccolissime margheritine.</l>
                        <l>
                            Le vite e i cespugli
                            <unclear cert="low">[?]</unclear>
                        </l>
                        <l>stanno ancora</l>
                        <l>nudi e marroncini</l>
                        <l>tra qualche tenera</l>
                        <l>erbetta verde.</l>
                        <l>Solo i mandorli</l>
                        <l>
                            sono
                            <del>fioriti</del>
                            <add>in fiore</add>
                        </l>
                        <l>
                            con
                            <del>delle</del>
                            cascate
                        </l>
                        <l>
                            di candidi
                            <del>fiori</del>
                            <add>petali</add>,
                        </l>
                        <l>bianchi e profumati.</l>

                    </lg>

                </div>

          <!-- FOGLIO 2 -->

                <div type="page" n="2">

                    <head>Foglio 2 di 3 – Versione per la stampa</head>

                    <note type="editorial">
                        Dal ciclo: La primavera del Salento.
                    </note>

                    <head>Bellis</head>

                    <lg>

                        <l>Siamo in febbraio,</l>
                        <l>la lunga primavera</l>
                        <l>del Salento</l>
                        <l>sta cominciando.</l>
                        <l>Tra ruderi caduti</l>
                        <l>e terreni abbandonati</l>
                        <l>un sentiero si aggira,</l>
                        <l>serpeggia</l>
                        <l>come un bianco ruscello,</l>
                        <l>coperto</l>
                        <l>da mille e mille</l>
                        <l>piccolissime margheritine.</l>
                        <l>Le vite, i cespugli</l>
                        <l>stanno ancora</l>
                        <l>nudi e marroncini</l>
                        <l>tra qualche tenera</l>
                        <l>erbetta verde.</l>
                        <l>Solo i mandorli</l>
                        <l>stanno in fiore,</l>
                        <l>bianchi e profumati.</l>

                    </lg>

                    <note type="illustration">
                        Illustrazione in acquarello.
                    </note>

                    <note type="bibliographic">
                        Nota botanica dalla Flora Salentina
                        di Martino Marinosci.
                    </note>

                    <note type="observation">
                        In trasparenza si legge un testo
                        in svedese, dal foglio sottostante.
                    </note>

                </div>

          <!-- FOGLIO 3 -->

                <div type="page" n="3">

                    <head>Foglio 3 di 3 – Versione firmata</head>

                    <dateline>
                        20 Febbraio
                        <note place="margin">1.</note>
                    </dateline>

                    <head>Bellis</head>

                    <lg>

                        <l>Siamo in febbraio.</l>
                        <l>La lunga primavera</l>
                        <l>del Salento</l>
                        <l>sta cominciando.</l>
                        <l>Tra ruderi caduti</l>
                        <l>e terreni abbandonati</l>
                        <l>un sentiero si aggira,</l>
                        <l>serpeggia</l>
                        <l>come un bianco ruscello,</l>
                        <l>coperto</l>
                        <l>da mille e mille</l>
                        <l>piccolissime margheritine.</l>
                        <l>Le vite, i cespugli</l>
                        <l>stanno ancora</l>
                        <l>nudi e marroncini</l>
                        <l>tra qualche tenera</l>
                        <l>erbetta verde.</l>
                        <l>Solo i mandorli</l>
                        <l>stanno in fiore,</l>
                        <l>bianchi e profumati.</l>

                    </lg>

                    <signed>Dagmar Davidson Calabrese</signed>

                </div>

            </div>

        </body>

